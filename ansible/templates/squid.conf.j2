# Package-download proxy only. Not a NAT gateway and not an open proxy.
http_port {{ control_private_ip }}:3128
visible_hostname quickbite-control

acl database_client src {{ hostvars['db']['ansible_host'] }}/32
acl ubuntu_repositories dstdomain .ubuntu.com .canonical.com
acl Safe_ports port 80 443
acl SSL_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow database_client ubuntu_repositories
http_access deny all

cache deny all
access_log /var/log/squid/access.log
