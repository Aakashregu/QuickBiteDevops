# Generated by Terraform. Run Ansible on the MANAGED control node, not bootstrap.
[control]
control ansible_connection=local

[application]
app ansible_host=${app_private_ip}

[database]
db ansible_host=${db_private_ip}

[docker_hosts:children]
control
application

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/home/ubuntu/.ssh/quickbite_lab
ansible_python_interpreter=/usr/bin/python3
control_private_ip=${control_private_ip}
